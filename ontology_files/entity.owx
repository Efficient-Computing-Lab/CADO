<?xml version="1.0"?>
<!--
    CADO - Container-Aware Deployment Ontology
    T-Box (schema). Version 2.0.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.semanticweb.org/container-ontologies/2024/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     ontologyIRI="http://www.semanticweb.org/container-ontologies/2024/"
     versionIRI="http://www.semanticweb.org/container-ontologies/2024/version/2.0/">
    <Prefix name="" IRI="http://www.semanticweb.org/container-ontologies/2024/"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Prefix name="dcterms" IRI="http://purl.org/dc/terms/"/>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:title"/>
        <Literal>CADO: Container-Aware Deployment Ontology</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:creator"/>
        <Literal>Georgios Korontanis</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:license"/>
        <Literal>https://opensource.org/licenses/MIT</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal>2.0</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal>A platform-agnostic vocabulary for container deployment workflows. CADO abstracts the concepts shared by Docker and Kubernetes so that a single deployment description can be transformed into the deployment artifacts of either platform.</Literal>
    </Annotation>
    <!-- ============ ANNOTATION PROPERTY DECLARATIONS ============ -->
    <Declaration><AnnotationProperty abbreviatedIRI="dcterms:title"/></Declaration>
    <Declaration><AnnotationProperty abbreviatedIRI="dcterms:creator"/></Declaration>
    <Declaration><AnnotationProperty abbreviatedIRI="dcterms:license"/></Declaration>
    <!-- ============ DECLARATIONS ============ -->
    <Declaration><Class IRI="container_orchestration_environment"/></Declaration>
    <Declaration><Class IRI="deployment_unit"/></Declaration>
    <Declaration><Class IRI="minimal_deployment_unit"/></Declaration>
    <Declaration><Class IRI="environment_variable"/></Declaration>
    <Declaration><Class IRI="group_by"/></Declaration>
    <Declaration><Class IRI="network"/></Declaration>
    <Declaration><Class IRI="service"/></Declaration>
    <Declaration><Class IRI="namespace"/></Declaration>
    <Declaration><Class IRI="host"/></Declaration>
    <Declaration><Class IRI="image"/></Declaration>
    <Declaration><Class IRI="image_registry"/></Declaration>
    <Declaration><Class IRI="private_image_registry"/></Declaration>
    <Declaration><Class IRI="public_image_registry"/></Declaration>
    <Declaration><Class IRI="platform"/></Declaration>
    <Declaration><Class IRI="subplatform"/></Declaration>
    <Declaration><Class IRI="runtime_environment"/></Declaration>
    <Declaration><Class IRI="secret"/></Declaration>
    <Declaration><Class IRI="storage"/></Declaration>
    <Declaration><Class IRI="ephemeral"/></Declaration>
    <Declaration><Class IRI="persistent"/></Declaration>
    <Declaration><Class IRI="volume_mount"/></Declaration>
    <Declaration><Class IRI="stateful_deployment_unit"/></Declaration>
    <Declaration><ObjectProperty IRI="binds"/></Declaration>
    <Declaration><ObjectProperty IRI="composedOf"/></Declaration>
    <Declaration><ObjectProperty IRI="containsMinimalDeploymentUnit"/></Declaration>
    <Declaration><ObjectProperty IRI="convertsToContainer"/></Declaration>
    <Declaration><ObjectProperty IRI="dependsOn"/></Declaration>
    <Declaration><ObjectProperty IRI="deploys"/></Declaration>
    <Declaration><ObjectProperty IRI="deployedBy"/></Declaration>
    <Declaration><ObjectProperty IRI="generatesGroupBy"/></Declaration>
    <Declaration><ObjectProperty IRI="generatesSecret"/></Declaration>
    <Declaration><ObjectProperty IRI="generatesStorage"/></Declaration>
    <Declaration><ObjectProperty IRI="groupedBy"/></Declaration>
    <Declaration><ObjectProperty IRI="hasEnvironmentVariable"/></Declaration>
    <Declaration><ObjectProperty IRI="hasVolumeMount"/></Declaration>
    <Declaration><ObjectProperty IRI="hostedBy"/></Declaration>
    <Declaration><ObjectProperty IRI="hosts"/></Declaration>
    <Declaration><ObjectProperty IRI="includesHost"/></Declaration>
    <Declaration><ObjectProperty IRI="includesImage"/></Declaration>
    <Declaration><ObjectProperty IRI="includesRunningInstance"/></Declaration>
    <Declaration><ObjectProperty IRI="loginTo"/></Declaration>
    <Declaration><ObjectProperty IRI="mountsStorage"/></Declaration>
    <Declaration><ObjectProperty IRI="pullsImageFrom"/></Declaration>
    <Declaration><ObjectProperty IRI="reservesDiskSpaceOn"/></Declaration>
    <Declaration><ObjectProperty IRI="runningInstanceOf"/></Declaration>
    <Declaration><ObjectProperty IRI="savedTo"/></Declaration>
    <Declaration><ObjectProperty IRI="unpacks"/></Declaration>
    <Declaration><ObjectProperty IRI="utilizes"/></Declaration>
    <Declaration><ObjectProperty IRI="utilizedBy"/></Declaration>
    <Declaration><DataProperty IRI="artifact_format"/></Declaration>
    <Declaration><DataProperty IRI="container_name"/></Declaration>
    <Declaration><DataProperty IRI="cpu_limit"/></Declaration>
    <Declaration><DataProperty IRI="memory_limit"/></Declaration>
    <Declaration><DataProperty IRI="deployment_name"/></Declaration>
    <Declaration><DataProperty IRI="driver"/></Declaration>
    <Declaration><DataProperty IRI="image_name"/></Declaration>
    <Declaration><DataProperty IRI="mount_path"/></Declaration>
    <Declaration><DataProperty IRI="namespace_name"/></Declaration>
    <Declaration><DataProperty IRI="network_name"/></Declaration>
    <Declaration><DataProperty IRI="ports"/></Declaration>
    <Declaration><DataProperty IRI="registry_url"/></Declaration>
    <Declaration><DataProperty IRI="replicas"/></Declaration>
    <Declaration><DataProperty IRI="reserved_storage"/></Declaration>
    <Declaration><DataProperty IRI="restart_policy"/></Declaration>
    <Declaration><DataProperty IRI="service_name"/></Declaration>
    <Declaration><DataProperty IRI="variable_name"/></Declaration>
    <Declaration><DataProperty IRI="variable_value"/></Declaration>
    <Declaration><DataProperty IRI="version"/></Declaration>
    <Declaration><DataProperty IRI="volume_host_path"/></Declaration>
    <Declaration><DataProperty IRI="volume_name"/></Declaration>
    <!-- ============ LABELS AND DEFINITIONS ============ -->
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/container_orchestration_environment</IRI>
        <Literal xml:lang="en">Container Orchestration Environment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/container_orchestration_environment</IRI>
        <Literal xml:lang="en">The top-level category of CADO. Any entity that participates in the description of a container deployment workflow.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/deployment_unit</IRI>
        <Literal xml:lang="en">Deployment Unit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/deployment_unit</IRI>
        <Literal xml:lang="en">A schedulable unit of execution created from one or more container images. Generalises a Docker container and a Kubernetes pod.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/minimal_deployment_unit</IRI>
        <Literal xml:lang="en">Minimal Deployment Unit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/minimal_deployment_unit</IRI>
        <Literal xml:lang="en">A deployment unit that cannot be decomposed further: it is the running instance of exactly one image. Corresponds to a single container.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/environment_variable</IRI>
        <Literal xml:lang="en">Environment Variable</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/environment_variable</IRI>
        <Literal xml:lang="en">A name/value pair supplied to a deployment unit at start-up. Reified so that arbitrary variables can be modelled without extending the T-Box.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/group_by</IRI>
        <Literal xml:lang="en">Group By</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/group_by</IRI>
        <Literal xml:lang="en">A named grouping construct that scopes a set of deployment units and governs how they are addressed by one another. Subsumes Docker networks, Docker Swarm and Kubernetes services, and Kubernetes namespaces.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/network</IRI>
        <Literal xml:lang="en">Network</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/network</IRI>
        <Literal xml:lang="en">A grouping construct that scopes deployment units by link-layer reachability. Corresponds to a Docker network.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/service</IRI>
        <Literal xml:lang="en">Service</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/service</IRI>
        <Literal xml:lang="en">A grouping construct that scopes deployment units behind a single stable endpoint. Corresponds to a Docker Swarm service or a Kubernetes service.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/namespace</IRI>
        <Literal xml:lang="en">Namespace</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/namespace</IRI>
        <Literal xml:lang="en">A grouping construct that scopes deployment units by name isolation. Corresponds to a Kubernetes namespace.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/host</IRI>
        <Literal xml:lang="en">Host</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/host</IRI>
        <Literal xml:lang="en">A physical or virtual machine that provides the compute and storage resources on which deployment units execute.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/image</IRI>
        <Literal xml:lang="en">Image</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/image</IRI>
        <Literal xml:lang="en">An immutable, layered, read-only template from which deployment units are instantiated.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/image_registry</IRI>
        <Literal xml:lang="en">Image Registry</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/image_registry</IRI>
        <Literal xml:lang="en">A service that stores and distributes container images.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/private_image_registry</IRI>
        <Literal xml:lang="en">Private Image Registry</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/private_image_registry</IRI>
        <Literal xml:lang="en">An image registry whose images can only be pulled after authentication.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/public_image_registry</IRI>
        <Literal xml:lang="en">Public Image Registry</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/public_image_registry</IRI>
        <Literal xml:lang="en">An image registry whose images can be pulled without authentication.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/platform</IRI>
        <Literal xml:lang="en">Platform</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/platform</IRI>
        <Literal xml:lang="en">A system that schedules deployment units onto hosts and manages their lifecycle.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/subplatform</IRI>
        <Literal xml:lang="en">Subplatform</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/subplatform</IRI>
        <Literal xml:lang="en">DEFINED CLASS. A platform that is utilised by another platform, i.e. it operates as a component of a larger platform rather than standalone. Inferred, not asserted.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/runtime_environment</IRI>
        <Literal xml:lang="en">Runtime Environment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/runtime_environment</IRI>
        <Literal xml:lang="en">The software layer that pulls images, unpacks them and converts them into running containers.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/secret</IRI>
        <Literal xml:lang="en">Secret</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/secret</IRI>
        <Literal xml:lang="en">Confidential data, typically credentials, consumed by a platform in order to authenticate against a private image registry.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/storage</IRI>
        <Literal xml:lang="en">Storage</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/storage</IRI>
        <Literal xml:lang="en">A storage resource that can be attached to a deployment unit.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/ephemeral</IRI>
        <Literal xml:lang="en">Ephemeral Storage</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/ephemeral</IRI>
        <Literal xml:lang="en">Storage whose contents do not survive the deployment unit that uses it.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/persistent</IRI>
        <Literal xml:lang="en">Persistent Storage</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/persistent</IRI>
        <Literal xml:lang="en">Storage whose contents survive the deployment unit that uses it, backed by disk space reserved on a host.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/volume_mount</IRI>
        <Literal xml:lang="en">Volume Mount</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/volume_mount</IRI>
        <Literal xml:lang="en">The reified attachment of a storage resource to a deployment unit at a specific path. Reified so that one deployment unit may mount several storage resources unambiguously.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/stateful_deployment_unit</IRI>
        <Literal xml:lang="en">Stateful Deployment Unit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/stateful_deployment_unit</IRI>
        <Literal xml:lang="en">DEFINED CLASS. A deployment unit that mounts at least one persistent storage resource. Inferred, not asserted.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/binds</IRI>
        <Literal xml:lang="en">binds</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/binds</IRI>
        <Literal xml:lang="en">Relates a deployment unit to a storage resource it attaches. Inferred from the property chain hasVolumeMount o mountsStorage.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/composedOf</IRI>
        <Literal xml:lang="en">composed of</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/composedOf</IRI>
        <Literal xml:lang="en">Relates a platform to the entities that constitute it.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/containsMinimalDeploymentUnit</IRI>
        <Literal xml:lang="en">contains minimal deployment unit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/containsMinimalDeploymentUnit</IRI>
        <Literal xml:lang="en">Relates a composite deployment unit to the minimal deployment units it contains. Renamed from multipleMinimalDeploymentUnit.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/convertsToContainer</IRI>
        <Literal xml:lang="en">converts to container</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/convertsToContainer</IRI>
        <Literal xml:lang="en">Relates a runtime environment to an image it turns into a running container.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/dependsOn</IRI>
        <Literal xml:lang="en">depends on</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/dependsOn</IRI>
        <Literal xml:lang="en">Relates a deployment unit to another that must be available before it starts. Replaces the depends_on data property.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/deploys</IRI>
        <Literal xml:lang="en">deploys</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/deploys</IRI>
        <Literal xml:lang="en">Relates a platform to a deployment unit whose lifecycle it manages.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/deployedBy</IRI>
        <Literal xml:lang="en">deployed by</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/deployedBy</IRI>
        <Literal xml:lang="en">Inverse of deploys.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/generatesGroupBy</IRI>
        <Literal xml:lang="en">generates group by</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/generatesGroupBy</IRI>
        <Literal xml:lang="en">Relates a platform to a grouping construct it creates.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/generatesSecret</IRI>
        <Literal xml:lang="en">generates secret</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/generatesSecret</IRI>
        <Literal xml:lang="en">Relates a platform to a secret it creates.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/generatesStorage</IRI>
        <Literal xml:lang="en">generates storage</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/generatesStorage</IRI>
        <Literal xml:lang="en">Relates a platform to a storage resource it provisions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/groupedBy</IRI>
        <Literal xml:lang="en">grouped by</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/groupedBy</IRI>
        <Literal xml:lang="en">Inverse of includesRunningInstance.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/hasEnvironmentVariable</IRI>
        <Literal xml:lang="en">has environment variable</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/hasEnvironmentVariable</IRI>
        <Literal xml:lang="en">Relates a deployment unit to an environment variable supplied to it.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/container-ontologies/2024/hasVolumeMount</IRI>
        <Literal xml:lang="en">has volume mount</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
