    <!-- ============ DATA PROPERTY ASSERTIONS ============ -->
    <DataPropertyAssertion><DataProperty IRI="artifact_format"/><NamedIndividual IRI="Docker"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">docker-compose</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="artifact_format"/><NamedIndividual IRI="Kubernetes"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">kubernetes-manifest</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="version"/><NamedIndividual IRI="Docker_Compose"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">3.7</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="registry_url"/><NamedIndividual IRI="Dockerhub"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">https://registry-1.docker.io/</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="image_name"/><NamedIndividual IRI="MySQL_Docker_Image"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">mysql:5.7</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="image_name"/><NamedIndividual IRI="Wordpress_Docker_Image"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">wordpress:latest</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="network_name"/><NamedIndividual IRI="Network"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">wordpress_network</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="namespace_name"/><NamedIndividual IRI="Namespace"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">wordpress-namespace</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="container_name"/><NamedIndividual IRI="MySQL_Docker_Container"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">mysql</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="restart_policy"/><NamedIndividual IRI="MySQL_Docker_Container"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">always</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="container_name"/><NamedIndividual IRI="Wordpress_Docker_Container"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">wordpress</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="container_name"/><NamedIndividual IRI="MySQL_Pod"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">mysql</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="deployment_name"/><NamedIndividual IRI="MySQL_Pod"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">mysql-deployment</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="replicas"/><NamedIndividual IRI="MySQL_Pod"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="container_name"/><NamedIndividual IRI="Wordpress_Pod"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">wordpress</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="deployment_name"/><NamedIndividual IRI="Wordpress_Pod"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">wordpress-deployment</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="replicas"/><NamedIndividual IRI="Wordpress_Pod"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="volume_name"/><NamedIndividual IRI="MySQL_Docker_Volume"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">mysql_data</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="volume_name"/><NamedIndividual IRI="Wordpress_Docker_Volume"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">wp-pv</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="volume_name"/><NamedIndividual IRI="MySQL_Kubernetes_Volume"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">mysql-pv</Literal></DataPropertyAssertion>
    <DataPropertyAssertion><DataProperty IRI="volume_host_path"/><NamedIndividual IRI="MySQL_Kubernetes_Volume"/><Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">/mnt/data/mysql</Literal></DataPropertyAssertion>
