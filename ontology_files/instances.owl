    <Declaration><NamedIndividual IRI="Namespace"/></Declaration>
    <Declaration><NamedIndividual IRI="Docker_Swarm_Services"/></Declaration>
    <Declaration><NamedIndividual IRI="Kubernetes_Services"/></Declaration>
    <Declaration><NamedIndividual IRI="MySQL_Docker_Image"/></Declaration>
    <Declaration><NamedIndividual IRI="Wordpress_Docker_Image"/></Declaration>
    <Declaration><NamedIndividual IRI="MySQL_Docker_Container"/></Declaration>
    <Declaration><NamedIndividual IRI="Wordpress_Docker_Container"/></Declaration>
    <Declaration><NamedIndividual IRI="MySQL_Pod"/></Declaration>
    <Declaration><NamedIndividual IRI="Wordpress_Pod"/></Declaration>
    <Declaration><NamedIndividual IRI="MySQL_Docker_Volume"/></Declaration>
    <Declaration><NamedIndividual IRI="Wordpress_Docker_Volume"/></Declaration>
    <Declaration><NamedIndividual IRI="MySQL_Kubernetes_Volume"/></Declaration>
    <Declaration><NamedIndividual IRI="Wordpress_Kubernetes_Volume"/></Declaration>
    <Declaration><NamedIndividual IRI="MySQL_Docker_Mount"/></Declaration>
    <Declaration><NamedIndividual IRI="Wordpress_Docker_Mount"/></Declaration>
    <Declaration><NamedIndividual IRI="MySQL_Pod_Mount"/></Declaration>
    <Declaration><NamedIndividual IRI="Wordpress_Pod_Mount"/></Declaration>
    <Declaration><NamedIndividual IRI="Env_MySQL_Database"/></Declaration>
    <Declaration><NamedIndividual IRI="Env_MySQL_Root_Password"/></Declaration>
