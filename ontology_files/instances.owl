<?xml version="1.0"?>
<!--
    CADO - Container-Aware Deployment Ontology
    A-Box (running example): WordPress + MySQL described once, deployed to Docker and Kubernetes.
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.semanticweb.org/container-ontologies/2024/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://www.semanticweb.org/container-ontologies/2024/individuals">
    <Prefix name="" IRI="http://www.semanticweb.org/container-ontologies/2024/"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Import>entity.owx</Import>
    <!-- ============ INDIVIDUALS ============ -->
    <Declaration><NamedIndividual IRI="Physical_Machine"/></Declaration>
    <Declaration><NamedIndividual IRI="Virtual_Machine"/></Declaration>
    <Declaration><NamedIndividual IRI="CRI-O"/></Declaration>
    <Declaration><NamedIndividual IRI="Containerd"/></Declaration>
