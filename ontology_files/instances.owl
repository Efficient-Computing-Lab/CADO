        <NamedIndividual IRI="Env_Wordpress_DB_Name"/>
        <NamedIndividual IRI="Env_Wordpress_DB_Password"/>
    </DifferentIndividuals>
    <!-- ============ OBJECT PROPERTY ASSERTIONS ============ -->
    <ObjectPropertyAssertion><ObjectProperty IRI="utilizes"/><NamedIndividual IRI="CRI-O"/><NamedIndividual IRI="RunC"/></ObjectPropertyAssertion>
    <ObjectPropertyAssertion><ObjectProperty IRI="utilizes"/><NamedIndividual IRI="Docker_Engine"/><NamedIndividual IRI="Containerd"/></ObjectPropertyAssertion>
    <ObjectPropertyAssertion><ObjectProperty IRI="utilizes"/><NamedIndividual IRI="Docker_Engine"/><NamedIndividual IRI="Dockerd"/></ObjectPropertyAssertion>
