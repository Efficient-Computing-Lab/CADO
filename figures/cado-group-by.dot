// engine=dot
digraph "group_by" {
  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.95, ranksep=1.10, fontname="Helvetica", fontsize=26, pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=22, margin="0.18,0.10", penwidth=1.6];
  edge  [fontname="Helvetica", fontsize=19, color="#37474F", fontcolor="#37474F", penwidth=1.4, arrowsize=0.9];
  "group_by" [label="group_by", fillcolor="#F1F8E9", color="#7CB342", penwidth=2.6];
  "deployment_unit" [label="deployment_unit", fillcolor="#E8EAF6", color="#5C6BC0"];
  "group_by" -> "deployment_unit" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>includesRunningInstance</TD></TR></TABLE>>];
  "namespace" [label="namespace", fillcolor="#E8EAF6", color="#5C6BC0"];
  "group_by" -> "namespace" [arrowhead=onormal, color="#5C6BC0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD><FONT COLOR="#5C6BC0">is-a</FONT></TD></TR></TABLE>>, style=dashed];
  "network" [label="network", fillcolor="#E8EAF6", color="#5C6BC0"];
  "group_by" -> "network" [arrowhead=onormal, color="#5C6BC0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD><FONT COLOR="#5C6BC0">is-a</FONT></TD></TR></TABLE>>, style=dashed];
  "service" [label="service", fillcolor="#E8EAF6", color="#5C6BC0"];
  "group_by" -> "service" [arrowhead=onormal, color="#5C6BC0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD><FONT COLOR="#5C6BC0">is-a</FONT></TD></TR></TABLE>>, style=dashed];
}