// engine=dot
digraph "image_registry" {
  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.95, ranksep=1.10, fontname="Helvetica", fontsize=26, pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=22, margin="0.18,0.10", penwidth=1.6];
  edge  [fontname="Helvetica", fontsize=19, color="#37474F", fontcolor="#37474F", penwidth=1.4, arrowsize=0.9];
  "image_registry" [label="image_registry", fillcolor="#F1F8E9", color="#7CB342", penwidth=2.6];
  "image" [label="image", fillcolor="#E8EAF6", color="#5C6BC0"];
  "image_registry" -> "image" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>includesImage</TD></TR></TABLE>>];
  "private_image_registry" [label="private_image_registry", fillcolor="#E8EAF6", color="#5C6BC0"];
  "image_registry" -> "private_image_registry" [arrowhead=onormal, color="#5C6BC0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD><FONT COLOR="#5C6BC0">is-a</FONT></TD></TR></TABLE>>, style=dashed];
  "public_image_registry" [label="public_image_registry", fillcolor="#E8EAF6", color="#5C6BC0"];
  "image_registry" -> "public_image_registry" [arrowhead=onormal, color="#5C6BC0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD><FONT COLOR="#5C6BC0">is-a</FONT></TD></TR></TABLE>>, style=dashed];
}