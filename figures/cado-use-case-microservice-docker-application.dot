// engine=dot
digraph "cado-use-case-microservice-docker-application" {
  graph [rankdir=TB, splines=true, overlap=false, nodesep=0.42, ranksep=1.05, fontname="Helvetica", fontsize=26, pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=22, margin="0.18,0.10", penwidth=1.6];
  edge  [fontname="Helvetica", fontsize=19, color="#37474F", fontcolor="#37474F", penwidth=1.4, arrowsize=0.9];
  "Api_Container" [label=<<B>Api Container</B><BR/><FONT POINT-SIZE="17"><I>minimal_deployment_unit</I></FONT><BR/><FONT POINT-SIZE="16">api</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Api_Image" [label=<<B>Api Image</B><BR/><FONT POINT-SIZE="17"><I>image</I></FONT><BR/><FONT POINT-SIZE="16">registry.example.com/shop/api:2.3.1</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Backend_Network" [label=<<B>Backend<BR/>Network</B><BR/><FONT POINT-SIZE="17"><I>network</I></FONT><BR/><FONT POINT-SIZE="16">backend</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Cache_Container" [label=<<B>Cache<BR/>Container</B><BR/><FONT POINT-SIZE="17"><I>minimal_deployment_unit</I></FONT><BR/><FONT POINT-SIZE="16">cache</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Cache_Scratch_Docker" [label=<<B>Cache Scratch<BR/>Docker</B><BR/><FONT POINT-SIZE="17"><I>ephemeral</I></FONT><BR/><FONT POINT-SIZE="16">cache_scratch</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Docker" [label=<<B>Docker</B><BR/><FONT POINT-SIZE="17"><I>platform</I></FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Edge_Container" [label=<<B>Edge Container</B><BR/><FONT POINT-SIZE="17"><I>minimal_deployment_unit</I></FONT><BR/><FONT POINT-SIZE="16">edge</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Frontend_Network" [label=<<B>Frontend<BR/>Network</B><BR/><FONT POINT-SIZE="17"><I>network</I></FONT><BR/><FONT POINT-SIZE="16">frontend</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Nginx_Image" [label=<<B>Nginx Image</B><BR/><FONT POINT-SIZE="17"><I>image</I></FONT><BR/><FONT POINT-SIZE="16">nginx:1.25-alpine</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Node_A" [label=<<B>Node A</B><BR/><FONT POINT-SIZE="17"><I>host</I></FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Redis_Image" [label=<<B>Redis Image</B><BR/><FONT POINT-SIZE="17"><I>image</I></FONT><BR/><FONT POINT-SIZE="16">redis:7-alpine</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Uploads_Volume_Docker" [label=<<B>Uploads Volume<BR/>Docker</B><BR/><FONT POINT-SIZE="17"><I>persistent</I></FONT><BR/><FONT POINT-SIZE="16">shop_uploads</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Api_Container" -> "Uploads_Volume_Docker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>binds (inferred)</TD></TR></TABLE>>];
  "Api_Container" -> "Cache_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>dependsOn</TD></TR></TABLE>>];
  "Api_Container" -> "Node_A" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>hostedBy</TD></TR></TABLE>>];
  "Api_Container" -> "Api_Image" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>runningInstanceOf</TD></TR></TABLE>>];
  "Backend_Network" -> "Api_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>includesRunningInstance</TD></TR></TABLE>>];
  "Backend_Network" -> "Cache_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>includesRunningInstance</TD></TR></TABLE>>];
  "Cache_Container" -> "Cache_Scratch_Docker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>binds (inferred)</TD></TR></TABLE>>];
  "Cache_Container" -> "Node_A" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>hostedBy</TD></TR></TABLE>>];
  "Cache_Container" -> "Redis_Image" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>runningInstanceOf</TD></TR></TABLE>>];
  "Docker" -> "Api_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>deploys</TD></TR></TABLE>>];
  "Docker" -> "Cache_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>deploys</TD></TR></TABLE>>];
  "Docker" -> "Edge_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>deploys</TD></TR></TABLE>>];
  "Edge_Container" -> "Api_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>dependsOn</TD></TR></TABLE>>];
  "Edge_Container" -> "Node_A" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>hostedBy</TD></TR></TABLE>>];
  "Edge_Container" -> "Nginx_Image" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>runningInstanceOf</TD></TR></TABLE>>];
  "Frontend_Network" -> "Api_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>includesRunningInstance</TD></TR></TABLE>>];
  "Frontend_Network" -> "Edge_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>includesRunningInstance</TD></TR></TABLE>>];
  "Uploads_Volume_Docker" -> "Node_A" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>reservesDiskSpaceOn</TD></TR></TABLE>>];
}