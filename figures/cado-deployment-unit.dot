// engine=dot
digraph "deployment_unit" {
  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.95, ranksep=1.10, fontname="Helvetica", fontsize=26, pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=22, margin="0.18,0.10", penwidth=1.6];
  edge  [fontname="Helvetica", fontsize=19, color="#37474F", fontcolor="#37474F", penwidth=1.4, arrowsize=0.9];
  "deployment_unit" [label="deployment_unit", fillcolor="#F1F8E9", color="#7CB342", penwidth=2.6];
  "storage" [label="storage", fillcolor="#E8EAF6", color="#5C6BC0"];
  "deployment_unit" -> "storage" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>binds</TD></TR></TABLE>>];
  "minimal_deployment_unit" [label="minimal_\ndeployment_unit", fillcolor="#E8EAF6", color="#5C6BC0"];
  "deployment_unit" -> "minimal_deployment_unit" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>containsMinimalDeploymentUnit</TD></TR></TABLE>>];
  "deployment_unit" -> "deployment_unit" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>dependsOn</TD></TR></TABLE>>, headport=nw, tailport=ne];
  "environment_variable" [label="environment_variable", fillcolor="#E8EAF6", color="#5C6BC0"];
  "deployment_unit" -> "environment_variable" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>hasEnvironmentVariable</TD></TR></TABLE>>];
  "volume_mount" [label="volume_mount", fillcolor="#E8EAF6", color="#5C6BC0"];
  "deployment_unit" -> "volume_mount" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>hasVolumeMount</TD></TR></TABLE>>];
  "host" [label="host", fillcolor="#E8EAF6", color="#5C6BC0"];
  "deployment_unit" -> "host" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>hostedBy</TD></TR></TABLE>>];
  "image" [label="image", fillcolor="#E8EAF6", color="#5C6BC0"];
  "deployment_unit" -> "image" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>runningInstanceOf</TD></TR></TABLE>>];
  "deployment_unit" -> "minimal_deployment_unit" [arrowhead=onormal, color="#5C6BC0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD><FONT COLOR="#5C6BC0">is-a</FONT></TD></TR></TABLE>>, style=dashed];
  "stateful_deployment_unit" [label="stateful_\ndeployment_unit", fillcolor="#E8EAF6", color="#5C6BC0"];
  "deployment_unit" -> "stateful_deployment_unit" [arrowhead=onormal, color="#5C6BC0", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD><FONT COLOR="#5C6BC0">is-a</FONT></TD></TR></TABLE>>, style=dashed];
}