// engine=dot
digraph "cado-use-case-docker-application" {
  graph [rankdir=TB, splines=true, overlap=false, nodesep=0.42, ranksep=1.05, fontname="Helvetica", fontsize=26, pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=22, margin="0.18,0.10", penwidth=1.6];
  edge  [fontname="Helvetica", fontsize=19, color="#37474F", fontcolor="#37474F", penwidth=1.4, arrowsize=0.9];
  "Docker" [label=<<B>Docker</B><BR/><FONT POINT-SIZE="17"><I>platform</I></FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "MySQL_Docker_Container" [label=<<B>MySQL Docker<BR/>Container</B><BR/><FONT POINT-SIZE="17"><I>minimal_deployment_unit</I></FONT><BR/><FONT POINT-SIZE="16">mysql</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "MySQL_Docker_Image" [label=<<B>MySQL Docker<BR/>Image</B><BR/><FONT POINT-SIZE="17"><I>image</I></FONT><BR/><FONT POINT-SIZE="16">mysql:5.7</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "MySQL_Docker_Volume" [label=<<B>MySQL Docker<BR/>Volume</B><BR/><FONT POINT-SIZE="17"><I>persistent</I></FONT><BR/><FONT POINT-SIZE="16">mysql_data</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Network" [label=<<B>Network</B><BR/><FONT POINT-SIZE="17"><I>network</I></FONT><BR/><FONT POINT-SIZE="16">wordpress_network</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Physical_Machine" [label=<<B>Physical<BR/>Machine</B><BR/><FONT POINT-SIZE="17"><I>host</I></FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Virtual_Machine" [label=<<B>Virtual<BR/>Machine</B><BR/><FONT POINT-SIZE="17"><I>host</I></FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Wordpress_Docker_Container" [label=<<B>Wordpress<BR/>Docker<BR/>Container</B><BR/><FONT POINT-SIZE="17"><I>minimal_deployment_unit</I></FONT><BR/><FONT POINT-SIZE="16">wordpress</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Wordpress_Docker_Image" [label=<<B>Wordpress<BR/>Docker Image</B><BR/><FONT POINT-SIZE="17"><I>image</I></FONT><BR/><FONT POINT-SIZE="16">wordpress:latest</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Wordpress_Docker_Volume" [label=<<B>Wordpress<BR/>Docker Volume</B><BR/><FONT POINT-SIZE="17"><I>persistent</I></FONT><BR/><FONT POINT-SIZE="16">wp-pv</FONT>>, fillcolor="#FFF8E1", color="#F9A825"];
  "Docker" -> "MySQL_Docker_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>deploys</TD></TR></TABLE>>];
  "Docker" -> "Wordpress_Docker_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>deploys</TD></TR></TABLE>>];
  "MySQL_Docker_Container" -> "MySQL_Docker_Volume" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>binds (inferred)</TD></TR></TABLE>>];
  "MySQL_Docker_Container" -> "Physical_Machine" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>hostedBy</TD></TR></TABLE>>];
  "MySQL_Docker_Container" -> "MySQL_Docker_Image" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>runningInstanceOf</TD></TR></TABLE>>];
  "MySQL_Docker_Volume" -> "Physical_Machine" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>reservesDiskSpaceOn</TD></TR></TABLE>>];
  "Network" -> "MySQL_Docker_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>includesRunningInstance</TD></TR></TABLE>>];
  "Network" -> "Wordpress_Docker_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>includesRunningInstance</TD></TR></TABLE>>];
  "Wordpress_Docker_Container" -> "Wordpress_Docker_Volume" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>binds (inferred)</TD></TR></TABLE>>];
  "Wordpress_Docker_Container" -> "MySQL_Docker_Container" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>dependsOn</TD></TR></TABLE>>];
  "Wordpress_Docker_Container" -> "Virtual_Machine" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>hostedBy</TD></TR></TABLE>>];
  "Wordpress_Docker_Container" -> "Wordpress_Docker_Image" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>runningInstanceOf</TD></TR></TABLE>>];
  "Wordpress_Docker_Volume" -> "Virtual_Machine" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1" CELLSPACING="0" BGCOLOR="white"><TR><TD>reservesDiskSpaceOn</TD></TR></TABLE>>];
}