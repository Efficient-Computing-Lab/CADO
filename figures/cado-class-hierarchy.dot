// engine=dot
digraph "hierarchy" {
  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.30, ranksep=1.30, fontname="Helvetica", fontsize=26, pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=22, margin="0.18,0.10", penwidth=1.6];
  edge  [fontname="Helvetica", fontsize=19, color="#37474F", fontcolor="#37474F", penwidth=1.4, arrowsize=0.9];
  "owl:Thing" [label="owl:Thing", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" [label="container_\norchestration_environment", fillcolor="#F1F8E9", color="#7CB342", penwidth=2.6];
  "owl:Thing" -> "container_orchestration_environment" [arrowhead=onormal, color="#5C6BC0"];
  "deployment_unit" [label="deployment_unit", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "deployment_unit" [arrowhead=onormal, color="#5C6BC0"];
  "minimal_deployment_unit" [label="minimal_\ndeployment_unit", fillcolor="#E8EAF6", color="#5C6BC0"];
  "deployment_unit" -> "minimal_deployment_unit" [arrowhead=onormal, color="#5C6BC0"];
  "stateful_deployment_unit" [label="stateful_\ndeployment_unit", fillcolor="#E8EAF6", color="#5C6BC0"];
  "deployment_unit" -> "stateful_deployment_unit" [arrowhead=onormal, color="#5C6BC0", style=dashed];
  "stateful_deployment_unit" [style="rounded,filled,dashed", penwidth=2.2];
  "environment_variable" [label="environment_variable", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "environment_variable" [arrowhead=onormal, color="#5C6BC0"];
  "group_by" [label="group_by", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "group_by" [arrowhead=onormal, color="#5C6BC0"];
  "namespace" [label="namespace", fillcolor="#E8EAF6", color="#5C6BC0"];
  "group_by" -> "namespace" [arrowhead=onormal, color="#5C6BC0"];
  "network" [label="network", fillcolor="#E8EAF6", color="#5C6BC0"];
  "group_by" -> "network" [arrowhead=onormal, color="#5C6BC0"];
  "service" [label="service", fillcolor="#E8EAF6", color="#5C6BC0"];
  "group_by" -> "service" [arrowhead=onormal, color="#5C6BC0"];
  "host" [label="host", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "host" [arrowhead=onormal, color="#5C6BC0"];
  "image" [label="image", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "image" [arrowhead=onormal, color="#5C6BC0"];
  "image_registry" [label="image_registry", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "image_registry" [arrowhead=onormal, color="#5C6BC0"];
  "private_image_registry" [label="private_image_registry", fillcolor="#E8EAF6", color="#5C6BC0"];
  "image_registry" -> "private_image_registry" [arrowhead=onormal, color="#5C6BC0"];
  "public_image_registry" [label="public_image_registry", fillcolor="#E8EAF6", color="#5C6BC0"];
  "image_registry" -> "public_image_registry" [arrowhead=onormal, color="#5C6BC0"];
  "platform" [label="platform", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "platform" [arrowhead=onormal, color="#5C6BC0"];
  "subplatform" [label="subplatform", fillcolor="#E8EAF6", color="#5C6BC0"];
  "platform" -> "subplatform" [arrowhead=onormal, color="#5C6BC0", style=dashed];
  "subplatform" [style="rounded,filled,dashed", penwidth=2.2];
  "runtime_environment" [label="runtime_environment", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "runtime_environment" [arrowhead=onormal, color="#5C6BC0"];
  "secret" [label="secret", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "secret" [arrowhead=onormal, color="#5C6BC0"];
  "storage" [label="storage", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "storage" [arrowhead=onormal, color="#5C6BC0"];
  "ephemeral" [label="ephemeral", fillcolor="#E8EAF6", color="#5C6BC0"];
  "storage" -> "ephemeral" [arrowhead=onormal, color="#5C6BC0"];
  "persistent" [label="persistent", fillcolor="#E8EAF6", color="#5C6BC0"];
  "storage" -> "persistent" [arrowhead=onormal, color="#5C6BC0"];
  "volume_mount" [label="volume_mount", fillcolor="#E8EAF6", color="#5C6BC0"];
  "container_orchestration_environment" -> "volume_mount" [arrowhead=onormal, color="#5C6BC0"];
}